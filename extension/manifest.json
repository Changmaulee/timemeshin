{
  "manifest_version": 3,
  "name": "TimeMeshin AI & Browser Time Stone DVR",
  "version": "1.1.0",
  "description": "Deterministic Spatio-Temporal DVR & Time Stone: Auto-saves AI chats, form inputs, scroll positions, and restores abruptly closed windows.",
  "permissions": [
    "storage",
    "tabs",
    "unlimitedStorage"
  ],
  "host_permissions": [
    "<all_urls>",
    "http://localhost:8765/*",
    "http://127.0.0.1:8765/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "icons": {
    "16": "icon16.png",
    "48": "icon48.png",
    "128": "icon128.png"
  },
  "action": {
    "default_popup": "popup.html",
    "default_title": "TimeMeshin Time Stone"
  },
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["content.js"],
      "run_at": "document_idle"
    }
  ]
}
